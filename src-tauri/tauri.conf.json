{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Pool",
  "version": "0.1.0",
  "identifier": "dev.local.codex-accounts",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [{
      "label": "main",
      "title": "AI Pool · Codex Accounts",
      "theme": "Light",
      "backgroundColor": "#f7f9fc",
      "width": 1120,
      "height": 800,
      "minWidth": 740,
      "minHeight": 540
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
